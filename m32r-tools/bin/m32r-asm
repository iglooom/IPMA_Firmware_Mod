#!/usr/bin/env bash
# Assemble big-endian M32R source and emit a flat binary.
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
AS="$ROOT/toolchain/bin/m32r-elf-as"
OBJCOPY="$ROOT/toolchain/bin/m32r-elf-objcopy"

usage() {
    printf 'Usage: %s INPUT.s OUTPUT.bin\n' "${0##*/}" >&2
    exit 2
}

[[ $# -eq 2 ]] || usage
[[ -x "$AS" && -x "$OBJCOPY" ]] || {
    printf 'Toolchain is not built; run %s/build.sh first.\n' "$ROOT" >&2
    exit 1
}

input=$1
output=$2
[[ -f "$input" ]] || { printf 'Input does not exist: %s\n' "$input" >&2; exit 1; }

output_dir=$(dirname -- "$output")
mkdir -p "$output_dir"
tmp_object=$(mktemp "${TMPDIR:-/tmp}/m32r-asm.XXXXXX.o")
trap 'rm -f -- "$tmp_object"' EXIT

"$AS" -EB -o "$tmp_object" "$input"
"$OBJCOPY" -O binary "$tmp_object" "$output"
